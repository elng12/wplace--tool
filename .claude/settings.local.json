{
  "permissions": {
    "allow": [
      "WebFetch(domain:happyship.app)",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_install",
      "Bash(node:*)",
      "Bash(python3:*)",
      "Bash(rm:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(for file in index.html about.html blog.html privacy.html terms.html color-converter.html)",
      "Bash(do echo -n \"$file: \")",
      "Bash(done)",
      "Bash(do echo -n \"$file 翻译系统: \")",
      "Bash(if grep -q \"translatePage\\|initializeI18n\" \"$file\")",
      "Bash(then echo \"✅ 有\")",
      "Bash(else echo \"❌ 缺失\")",
      "Bash(fi)",
      "Bash(then echo \"✅ 有翻译系统\")",
      "Bash(comm:*)",
      "Bash(npm:*)",
      "Bash(python:*)",
      "Bash(npx @tailwindcss/cli@latest build:*)",
      "Bash(npx tailwindcss:*)",
      "Bash(tailwindcss:*)",
      "Bash(cat:*)",
      "Bash(for file in about.html blog.html color-converter.html privacy.html terms.html)",
      "Bash(do sed -i 's|<script src=\"\"js/i18n.js\"\"></script>|<script src=\"\"js/i18n.js\"\"></script>\\n\\n  <!-- 错误处理系统 -->\\n  <script src=\"\"js/error-handler.js\"\"></script>|g' \"$file\")",
      "Bash(for file in blog/*.html)",
      "Bash(do sed -i 's|<script src=\"\"../js/i18n.js\"\"></script>|<script src=\"\"../js/i18n.js\"\"></script>\\n\\n  <!-- 错误处理系统 -->\\n  <script src=\"\"../js/error-handler.js\"\"></script>|g' \"$file\")",
      "Bash(rg:*)",
      "mcp__playwright__playwright_console_logs",
      "mcp__playwright__playwright_evaluate",
      "mcp__playwright__playwright_click",
      "Bash(for file in *.json)",
      "Bash(do if [ \"$file\" != \"en.json\" ])",
      "Bash(then echo -n \"$file: \")",
      "Bash(jq:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "mcp__playwright__playwright_navigate"
    ],
    "deny": [],
    "ask": []
  }
}