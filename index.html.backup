<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Easily create pixel art for Wplace with the Wplace Paint Tool! Our pixel art maker and converter transform any image into a Wplace-compatible pixel grid. The built-in generator automatically matches the official color palette, ensuring perfect results every time. Whether you're a beginner or a pro, this tool makes pixel art creation fun and simple. Turn your ideas into pixel masterpieces effortlessly!" />
  <title>Wplace Paint Tool & Color Converter - Ultimate Pixel Art Toolkit for Wplace Players</title>
  <link rel="canonical" href="https://wplacetool.app/" />
  <!-- Tailwind CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3219924658522446" crossorigin="anonymous"></script>
  <!-- Custom Styles -->
  <link rel="stylesheet" href="css/main.css" />
  
  <!-- Simple Version Script - No Modules Required -->
  <script src="js/app-simple.js" defer></script>
  
  <!-- Avatar Styles -->
  <style>
    .avatar-gradient {
      position: relative;
      overflow: hidden;
    }
    
    .avatar-gradient::before {
      content: '';
      position: absolute;
      top: -2px;
      left: -2px;
      right: -2px;
      bottom: -2px;
      background: linear-gradient(45deg, rgba(255,255,255,0.3), transparent);
      border-radius: inherit;
      pointer-events: none;
    }
    
    .avatar-gradient:hover {
      transform: scale(1.05);
      transition: transform 0.2s ease;
    }
    
    /* 修复页面布局问题 */
    body {
      margin: 0;
      padding: 0;
      font-size: 16px;
      line-height: 1.5;
    }
    
    /* 确保容器不会过大 */
    .max-w-6xl {
      max-width: 72rem;
    }
    
    /* 修复响应式布局 */
    @media (max-width: 768px) {
      .text-4xl {
        font-size: 1.875rem;
      }
      .text-xl {
        font-size: 1.125rem;
      }
    }
  </style>
</head>
<body class="bg-background text-foreground min-h-screen">
  <!-- Header Navigation -->
  <header class="bg-card shadow-sm border-border border-b sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 relative">
        <!-- Logo and Brand -->
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 bg-blue-500 rounded-full"></div>
          <h2 class="text-xl font-bold text-card-foreground" data-lang="brand.name">Wplace Paint Tool</h2>
        </div>

        <!-- Navigation Menu -->
        <nav class="hidden md:flex items-center space-x-6 ml-auto">
          <a href="index.html" class="text-blue-600 px-3 py-2 text-sm font-medium border-b-2 border-blue-600" data-lang="nav.home">Home</a>
          <a href="color-converter.html" class="text-gray-600 hover:text-gray-900 px-3 py-2 text-sm font-medium" data-lang="nav.converter">Converter</a>
          <a href="blog.html" class="text-gray-600 hover:text-gray-900 px-3 py-2 text-sm font-medium" data-lang="nav.blog">Blog</a>
          <a href="about.html" class="text-gray-600 hover:text-gray-900 px-3 py-2 text-sm font-medium" data-lang="nav.about">About</a>
          <a href="privacy.html" class="text-gray-600 hover:text-gray-900 px-3 py-2 text-sm font-medium" data-lang="nav.privacy">Privacy</a>
          <a href="terms.html" class="text-gray-600 hover:text-gray-900 px-3 py-2 text-sm font-medium" data-lang="nav.terms">Terms</a>
        </nav>

        <!-- Mobile Menu Button & Language Selector -->
        <div class="flex items-center space-x-3">
          <!-- Mobile menu button -->
          <button id="mobileMenuButton" class="md:hidden p-2 rounded-lg text-gray-600 hover:bg-gray-100 focus:outline-none">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>

        <!-- Language Selector -->
          <div class="bg-muted rounded-lg border-border border p-1">
            <select id="languageSelector" class="bg-transparent border-none focus:outline-none cursor-pointer text-sm font-medium px-2 py-1">
              <option value="en" selected>English</option>
              <option value="zh">中文</option>
            </select>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Mobile Navigation Menu -->
    <div id="mobileMenu" class="md:hidden bg-white border-t border-gray-200 hidden">
      <div class="px-4 py-3 space-y-2">
        <a href="index.html" class="block px-3 py-2 text-blue-600 text-sm font-medium" data-lang="nav.home">Home</a>
        <a href="color-converter.html" class="block px-3 py-2 text-gray-600 hover:text-gray-900 text-sm font-medium" data-lang="nav.converter">Converter</a>
        <a href="blog.html" class="block px-3 py-2 text-gray-600 hover:text-gray-900 text-sm font-medium" data-lang="nav.blog">Blog</a>
        <a href="about.html" class="block px-3 py-2 text-gray-600 hover:text-gray-900 text-sm font-medium" data-lang="nav.about">About</a>
        <a href="privacy.html" class="block px-3 py-2 text-gray-600 hover:text-gray-900 text-sm font-medium" data-lang="nav.privacy">Privacy</a>
        <a href="terms.html" class="block px-3 py-2 text-gray-600 hover:text-gray-900 text-sm font-medium" data-lang="nav.terms">Terms</a>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="bg-card py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-foreground mb-4" data-lang="hero.title">Wplace Paint Tool: The Ultimate Pixel Toolkit to Dominate the Canvas</h1>
        <p class="text-xl text-muted-foreground mb-8" data-lang="hero.description">Designed for creative players on wplace.live, this ultimate toolkit lets you dominate the canvas with ease. Our core feature converts any image to pixel art, automatically matching the official color palette to bring your vision to life. It also includes efficient scripts and professional planning tools to fully enhance your gameplay. Join now, unlock vast resources, and start creating stunning artwork.</p>
      </div>
    </div>
  </section>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Two Column Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
      <!-- Left Column: Upload Area and Controls -->
      <div class="flex flex-col space-y-6">
        <!-- Upload Area -->
        <div class="flex-1">
          <div class="bg-card rounded-lg shadow-sm border-2 border-dashed border-border hover:border-primary transition-colors duration-300 h-full">
            <div id="uploadArea" class="p-8 text-center cursor-pointer h-full flex flex-col justify-center">
              <div class="space-y-4">
                <div class="mx-auto w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center">
                  <svg class="w-8 h-8 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                  </svg>
                </div>
                <div>
                  <p class="text-lg font-medium text-gray-900" data-lang="upload.main">Click to upload or drag image here</p>
                  <p class="text-sm text-gray-500" data-lang="upload.sub">Supports PNG, JPG formats (max 4MB)</p>
                  <p class="text-xs text-gray-400 mt-1">支持多选批量处理</p>
                </div>
              </div>
              <input type="file" id="fileInput" accept=".png,.jpg,.jpeg" multiple class="hidden">
            </div>
          </div>
        </div>

        <!-- Pixel Size Control -->
        <div class="flex-shrink-0">
          <div class="bg-card rounded-lg shadow-sm border-border border p-6">
            <div class="space-y-4">
              <div class="flex justify-between items-center">
                <label for="size-slider" class="block text-sm font-medium text-card-foreground">
                  <span data-lang="pixel.size">Pixel Size</span>
              </label>
                <span id="size-value" class="font-bold text-primary">8</span>
              </div>
              <input 
                type="range" 
                id="size-slider" 
                min="1" 
                max="32" 
                value="8" 
                class="w-full h-2 bg-muted rounded-lg appearance-none cursor-pointer custom-slider"
              >
              <p class="text-xs text-muted-foreground text-center" data-lang="pixel.desc">Real-time preview as you adjust the slider</p>
            </div>
          </div>
        </div>

        <!-- Advanced Settings -->
        <div class="flex-shrink-0">
          <div class="bg-card rounded-lg shadow-sm border-border border">
            <!-- Accordion Header -->
            <button id="advancedSettingsButton" class="w-full flex items-center justify-between p-6 text-left">
              <h3 class="text-sm font-medium text-card-foreground" data-lang="advanced.title">Advanced Settings</h3>
              <svg id="advancedSettingsIcon" class="w-5 h-5 text-muted-foreground transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            
            <!-- Accordion Content (Initially Hidden) -->
            <div id="advancedSettingsContent" class="hidden px-6 pb-6">
                <div class="space-y-4 border-t border-border pt-4">
              
              <!-- Quality Slider -->
              <div class="space-y-2">
                <div class="flex justify-between items-center">
                  <label for="quality-slider" class="block text-sm font-medium text-card-foreground" data-lang="controls.quality">Quality</label>
                  <span id="quality-value" class="font-bold text-primary">80%</span>
                </div>
                <input type="range" id="quality-slider" min="1" max="100" value="80" class="w-full h-2 bg-muted rounded-lg appearance-none cursor-pointer">
              </div>
              
              <!-- Brightness Slider -->
              <div class="space-y-2">
                <div class="flex justify-between items-center">
                  <label for="brightness-slider" class="block text-sm font-medium text-card-foreground" data-lang="controls.brightness">Brightness</label>
                  <span id="brightness-value" class="font-bold text-primary">0</span>
                </div>
                <input type="range" id="brightness-slider" min="-100" max="100" value="0" class="w-full h-2 bg-muted rounded-lg appearance-none cursor-pointer">
              </div>
              
              <!-- Contrast Slider -->
              <div class="space-y-2">
                <div class="flex justify-between items-center">
                  <label for="contrast-slider" class="block text-sm font-medium text-card-foreground" data-lang="controls.contrast">Contrast</label>
                  <span id="contrast-value" class="font-bold text-primary">0</span>
                </div>
                <input type="range" id="contrast-slider" min="-100" max="100" value="0" class="w-full h-2 bg-muted rounded-lg appearance-none cursor-pointer">
              </div>
              
              <!-- Saturation Slider -->
              <div class="space-y-2">
                <div class="flex justify-between items-center">
                  <label for="saturation-slider" class="block text-sm font-medium text-card-foreground" data-lang="controls.saturation">Saturation</label>
                  <span id="saturation-value" class="font-bold text-primary">0</span>
                </div>
                <input type="range" id="saturation-slider" min="-100" max="100" value="0" class="w-full h-2 bg-muted rounded-lg appearance-none cursor-pointer">
              </div>
              
              <!-- Dithering Option -->
              <div class="flex items-center space-x-3">
                      <input type="checkbox" id="dithering-checkbox" class="h-4 w-4 text-primary rounded focus:ring-ring">
                      <label for="dithering-checkbox" class="text-sm text-card-foreground" data-lang="advanced.dithering">
                  Enable Floyd-Steinberg Dithering
                </label>
              </div>
              
              <!-- Palette Selection -->
              <div class="space-y-2">
                <label for="palette-select" class="block text-xs font-medium text-muted-foreground" data-lang="controls.color_palette">Color Palette:</label>
                <select id="palette-select" class="block w-full px-3 py-2 border-border bg-background rounded-md shadow-sm focus:outline-none focus:ring-ring focus:border-ring text-sm">
                  <option value="place">Wplace Palette</option>
                  <option value="standard">Standard Palette</option>
                </select>
              </div>
              
              <!-- Scaling Method -->
              <div class="space-y-2">
                      <label for="scalingMethod" class="block text-xs font-medium text-muted-foreground" data-lang="advanced.scaling">
                  Image Scaling Method:
                </label>
                      <select id="scalingMethod" class="block w-full px-3 py-2 border-border bg-background rounded-md shadow-sm focus:outline-none focus:ring-ring focus:border-ring text-sm">
                  <option value="nearest" data-lang="scaling.nearest">Nearest Neighbor</option>
                  <option value="bilinear" data-lang="scaling.bilinear">Bilinear</option>
                  <option value="lanczos" data-lang="scaling.lanczos">Lanczos</option>
                </select>
              </div>
              
              <!-- Grid Toggle -->
              <div class="flex items-center space-x-3">
                      <input type="checkbox" id="showGrid" class="h-4 w-4 text-primary rounded focus:ring-ring">
                      <label for="showGrid" class="text-sm text-card-foreground" data-lang="advanced.grid">
                  Show Pixel Grid
                </label>
                    </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Preview Area -->
      <div class="flex flex-col">
        <div class="flex-1">
          <div class="bg-card rounded-lg shadow-sm border-border border p-6 h-full flex flex-col">
            <!-- Preview Header -->
            <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
                <!-- Title -->
                <h2 class="text-lg font-semibold text-foreground" data-lang="preview.title">Wplace Pixel Art Result</h2>
                
                <!-- Controls & Buttons -->
                <div class="flex flex-wrap items-center gap-2">
                    <!-- Grid Info Panel -->
                    <div id="gridInfoPanel" class="flex items-center text-xs text-muted-foreground space-x-2 hidden">
                        <span>H: <span id="gridHorizontal">0</span></span>
                        <span>V: <span id="gridVertical">0</span></span>
                        <span>Total: <span id="gridTotal">0</span></span>
            </div>
            
                    <!-- Control Buttons -->
                    <div class="flex items-center space-x-2">
                        <button id="process-btn" class="px-3 py-1.5 text-xs bg-green-600 text-white rounded hover:bg-green-700 focus:outline-none focus:ring-1 focus:ring-green-500 disabled:opacity-50 disabled:cursor-not-allowed transition-colors" disabled>
                            Process
                        </button>
                        <button id="reset-btn" class="px-3 py-1.5 text-xs bg-gray-600 text-white rounded hover:bg-gray-700 focus:outline-none focus:ring-1 focus:ring-gray-500 transition-colors">
                            Reset
                        </button>
                        <button
                            id="downloadWithGridBtn"
                            class="px-3 py-1.5 text-xs bg-orange-600 text-white rounded hover:bg-orange-700 focus:outline-none focus:ring-1 focus:ring-orange-500 disabled:opacity-50 disabled:cursor-not-allowed transition-colors hidden"
                            disabled
                        >
                            Grid
                        </button>
              <button 
                id="download-btn" 
                            class="px-3 py-1.5 text-xs bg-blue-600 text-white rounded hover:bg-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed transition-colors hidden"
                disabled
                data-lang="btn.download"
              >
                Download
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Toggle Controls -->
            <div id="toggleControls" class="flex items-center justify-end space-x-4 mb-4 text-xs hidden">
                <div class="flex items-center space-x-2">
                    <span>Grid:</span>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="gridToggle" class="sr-only peer">
                        <div class="w-6 h-3 bg-gray-300 rounded-full peer peer-checked:bg-blue-600 transition-colors">
                            <div class="absolute top-0.5 left-0.5 bg-white w-2 h-2 rounded-full transition-transform peer-checked:translate-x-3"></div>
                        </div>
                    </label>
                </div>
                <div class="flex items-center space-x-2">
                    <span>Color:</span>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="colorToggle" class="sr-only peer" checked>
                        <div class="w-6 h-3 bg-blue-600 rounded-full peer peer-checked:bg-blue-600 transition-colors">
                            <div class="absolute top-0.5 left-3 bg-white w-2 h-2 rounded-full transition-transform peer-checked:translate-x-0"></div>
                        </div>
                    </label>
                </div>
                <button id="shareBtn" class="text-gray-500 hover:text-gray-700 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z"></path>
                    </svg>
              </button>
            </div>
            
            <div id="previewContainer" class="flex-1 min-h-96 max-w-full border-2 border-dashed border-border rounded-lg flex flex-col overflow-auto relative">
              <!-- Image preview area -->
              <div class="flex-1 flex items-center justify-center p-4 relative">
                <canvas id="preview-canvas" class="hidden border border-gray-300 rounded" style="max-width: 100%; max-height: 400px;"></canvas>
                <canvas id="output-canvas" class="hidden border border-gray-300 rounded" style="max-width: 100%; max-height: 400px;"></canvas>
                <p id="upload-prompt" class="text-muted-foreground" data-lang="preview.prompt">Please upload an image to start</p>
                
                <div id="image-info" class="absolute top-2 left-2 bg-white bg-opacity-90 p-2 rounded text-sm hidden"></div>
                
                <!-- Progress Bar -->
                <div id="progress-bar" class="absolute bottom-2 left-2 right-2 bg-white bg-opacity-90 p-2 rounded hidden">
                  <div class="w-full bg-gray-200 rounded-full h-2">
                    <div id="progress-indicator" class="bg-blue-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
                  </div>
                  <p id="progress-text" class="text-xs text-gray-600 mt-1 text-center">0%</p>
                </div>
                
                <!-- Color Info Tooltip -->
                <div id="colorTooltip" class="absolute bg-black text-white px-2 py-1 rounded text-xs pointer-events-none hidden z-10">
                  <div id="colorInfo"></div>
                </div>
                
                <!-- Zoom Controls -->
                <div id="zoomControls" class="absolute top-2 right-2 flex flex-col space-y-1 hidden">
                  <button id="zoomIn" class="bg-white shadow-md hover:bg-gray-50 p-2 rounded text-gray-700 text-xs">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                    </svg>
                  </button>
                  <button id="zoomOut" class="bg-white shadow-md hover:bg-gray-50 p-2 rounded text-gray-700 text-xs">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 12H6"></path>
                    </svg>
                  </button>
                  <button id="zoomReset" class="bg-white shadow-md hover:bg-gray-50 p-2 rounded text-gray-700 text-xs">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Used Colors Panel -->
        <div id="usedColorsPanel" class="mt-4 hidden">
          <div class="bg-card rounded-lg shadow-sm border-border border p-4">
            <h3 class="text-sm font-medium text-card-foreground mb-3" data-lang="used.colors.title">Colors Used in This Image</h3>
            <div id="usedColorsGrid" class="grid grid-cols-8 gap-2 mb-3"></div>
            <div class="flex justify-between text-xs text-muted-foreground">
              <span><span data-lang="used.colors.total">Total</span>: <span id="usedColorsTotal">0</span></span>
              <span><span data-lang="used.colors.free">Free</span>: <span id="usedColorsFree">0</span></span>
              <span><span data-lang="used.colors.premium">Premium</span>: <span id="usedColorsPremium">0</span></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Color Palette -->
    <section class="mb-8">
      <div class="bg-card rounded-lg shadow-sm border-border border p-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4">
          <h2 class="text-md font-semibold text-foreground mb-2 sm:mb-0" data-lang="palette.title">Wplace 64-Color Palette</h2>
          <div class="flex items-center space-x-2 text-xs text-muted-foreground">
            <div class="flex items-center space-x-1">
              <div class="w-3 h-3 bg-green-500 rounded-sm"></div>
              <span data-lang="palette.free">Free (32)</span>
            </div>
            <div class="flex items-center space-x-1">
              <div class="w-3 h-3 bg-orange-500 rounded-sm flex items-center justify-center">
                <span class="text-white text-xs">🔒</span>
              </div>
              <span data-lang="palette.premium">Premium (32)</span>
            </div>
          </div>
        </div>
        
        <div id="paletteDisplay" class="grid grid-cols-8 sm:grid-cols-16 md:grid-cols-32 gap-1">
          <!-- Palette will be populated by JavaScript -->
        </div>
        <p class="text-xs text-muted-foreground mt-2 text-center" data-lang="palette.info">Official Wplace color palette</p>
      </div>
    </section>

    <!-- Loading Indicator -->
    <div id="loadingIndicator" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-40 hidden">
      <div class="bg-white rounded-lg p-6 flex items-center space-x-3">
        <div class="flex space-x-1">
          <div class="w-3 h-3 bg-primary rounded-full animate-pulse"></div>
          <div class="w-3 h-3 bg-primary rounded-full animate-pulse" style="animation-delay: 0.2s;"></div>
          <div class="w-3 h-3 bg-primary rounded-full animate-pulse" style="animation-delay: 0.4s;"></div>
        </div>
        <span class="text-gray-700 font-medium" data-lang="loading">Processing...</span>
      </div>
    </div>
  </main>

  <!-- Features Section -->
  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4" data-lang="features.special.title">What Makes Our Wplace Image Converter Special?</h2>
        <p class="text-xl text-gray-600" data-lang="features.subtitle.desc">Transform any image into stunning pixel art designed for Wplace</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="mx-auto w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-4">
            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
