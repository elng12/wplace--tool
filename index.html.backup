    function translateText(key, lang = window.pageCurrentLanguage) {
      return translations[lang] && translations[lang][key] ? translations[lang][key] : key;
    }
    
    function translatePage(lang) {
      console.log(`🌐 正在翻译页面到: ${lang}`);
      console.log(`📝 当前pageCurrentLanguage: ${window.pageCurrentLanguage}`);
      console.log(`📚 可用翻译语言:`, Object.keys(translations));
      window.pageCurrentLanguage = lang;
      const elements = document.querySelectorAll('[data-lang]');
      console.log(`🔍 找到 ${elements.length} 个需要翻译的元素`);
      let translatedCount = 0;
      
      elements.forEach(el => {
        const key = el.getAttribute('data-lang');
        const translation = translations[lang] && translations[lang][key] ? translations[lang][key] : null;
        console.log(`  翻译键: ${key} -> ${translation ? '已翻译' : '保留原文'}`);
        
        // 只有找到翻译时才更新元素内容
        if (translation) {
          if (el.innerHTML.includes('<br>') || el.innerHTML.includes('\n')) {
            el.innerHTML = translation.replace(/\n/g, '<br>');
          } else {
            el.textContent = translation;
          }
          translatedCount++;
        }
        // 如果没有找到翻译，保留元素的原始内容不变
      });
      
      console.log(`✅ 翻译完成: ${translatedCount}个元素`);
      localStorage.setItem('preferredLanguage', lang);
      
      // Update language selector
      const selector = document.getElementById('languageSelector');
      if (selector) {
        selector.value = lang;
      }
    }
    
    function initializeI18n() {
      console.log('🚀 正在初始化翻译系统...');
      // Get saved language preference
      const savedLang = localStorage.getItem('preferredLanguage') || 'en';
      console.log(`💾 保存的语言偏好: ${savedLang}`);
      window.pageCurrentLanguage = savedLang;
      
      // Set up language selector
      const languageSelector = document.getElementById('languageSelector');
      if (languageSelector) {
        languageSelector.value = savedLang;
        languageSelector.addEventListener('change', (e) => {
          translatePage(e.target.value);
        });
      }
      
      // Initial translation
      translatePage(savedLang);
      
      // Mobile menu toggle
      const mobileMenuButton = document.getElementById('mobileMenuButton');
      const mobileMenu = document.getElementById('mobileMenu');
      
      if (mobileMenuButton && mobileMenu) {
        mobileMenuButton.addEventListener('click', () => {
          mobileMenu.classList.toggle('hidden');
        });
      }
      
      console.log('🎯 多语言系统初始化完成');
    }
    
    // Mobile menu functionality
    const mobileMenuButton = document.getElementById('mobileMenuButton');
    const mobileMenu = document.getElementById('mobileMenu');
    
    if (mobileMenuButton && mobileMenu) {
      mobileMenuButton.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    }
  </script>
</body>
</html>