// Simple i18n system
class I18n {
    constructor() {
        this.currentLang = 'en';
        this.translations = {};
        this.loadingPromises = {}; // 防止重复请求
        // 立即加载所有备用翻译，确保翻译数据总是可用的
        Object.keys(FALLBACK_TRANSLATIONS).forEach(lang => {
            this.translations[lang] = FALLBACK_TRANSLATIONS[lang];
        });
        this.loadSavedLanguage();
    }

    async loadLanguage(lang) {
        // 如果已经加载过，直接使用缓存
        if (this.translations[lang]) {
            this.currentLang = lang;
            this.updateDOM();
            this.saveLanguage();
            return;
        }
        
        // 如果没有该语言的翻译，回退到英文
        if (!FALLBACK_TRANSLATIONS[lang] && !this.translations[lang]) {
            console.warn(`⚠️ 语言 '${lang}' 暂不支持，使用英文`);
            this.currentLang = 'en';
            this.updateDOM();
            this.saveLanguage();
            return;
        }
        
        // 如果正在加载中，等待加载完成
        if (this.loadingPromises[lang]) {
            await this.loadingPromises[lang];
            return;
        }
        
        // 开始加载
        this.loadingPromises[lang] = this._loadLanguageFile(lang);
        await this.loadingPromises[lang];
        delete this.loadingPromises[lang];
    }
    
    async _loadLanguageFile(lang) {
        try {
            // 通过追加时间戳参数与禁止缓存，避免翻译文件被浏览器长期缓存，导致新键显示为键名
            const url = `lang/${lang}.json?v=${Date.now()}`;
            const response = await fetch(url, {
                cache: 'no-cache'
            });
            if (!response.ok) throw new Error(`Failed to load ${lang}.json`);
            this.translations[lang] = await response.json();
            this.currentLang = lang;
            this.updateDOM();
            this.saveLanguage();
        } catch (error) {
            console.warn('Failed to load language file, trying fallback:', error);
            
            // 使用备用翻译数据（用于解决CORS问题）
            if (FALLBACK_TRANSLATIONS[lang]) {
                console.log(`✅ 使用备用翻译: ${lang}`);
                this.translations[lang] = FALLBACK_TRANSLATIONS[lang];
                this.currentLang = lang;
                this.updateDOM();
                this.saveLanguage();
                return;
            }
            
            // 如果没有备用翻译，尝试英文
            if (lang !== 'en') {
                console.log('🔄 回退到英文');
                if (FALLBACK_TRANSLATIONS['en']) {
                    this.translations['en'] = FALLBACK_TRANSLATIONS['en'];
                    this.currentLang = 'en';
                    this.updateDOM();
                    this.saveLanguage();
                    return;
                }
            }
            
            console.error('❌ 无法加载任何翻译数据');
        }
    }

    t(key, ...args) {
        // 优先当前语言 → 其次英文 → 最后返回键名
        const langDict = this.translations[this.currentLang] || {};
        const enDict = this.translations['en'] || {};
        const text = (langDict[key] ?? enDict[key] ?? key);
        return args.length > 0 ? this.formatString(text, ...args) : text;
    }

    formatString(template, ...args) {
        return template.replace(/{(\d+)}/g, (match, number) => {
            return typeof args[number] !== 'undefined' ? args[number] : match;
        });
    }

    updateDOM() {
        // Update document title and lang attribute
        document.title = this.t('title');
        document.documentElement.lang = this.currentLang;

        // Update meta description
        const metaDescription = document.querySelector('meta[name="description"]');
        if (metaDescription) {
            metaDescription.setAttribute('content', this.t('subtitle'));
        }

        // Update Open Graph meta tags
        const ogTitle = document.querySelector('meta[property="og:title"]');
        if (ogTitle) {
            ogTitle.setAttribute('content', this.t('title'));
        }
        
        const ogDescription = document.querySelector('meta[property="og:description"]');
        if (ogDescription) {
            ogDescription.setAttribute('content', this.t('subtitle'));
        }

        // Update Twitter meta tags
        const twitterTitle = document.querySelector('meta[property="twitter:title"]');
        if (twitterTitle) {
            twitterTitle.setAttribute('content', this.t('title'));
        }
        
        const twitterDescription = document.querySelector('meta[property="twitter:description"]');
        if (twitterDescription) {
            twitterDescription.setAttribute('content', this.t('subtitle'));
        }

        // Update text content - 同时处理 data-lang 和 data-i18n
        document.querySelectorAll('[data-lang], [data-i18n]').forEach(element => {
            // Skip language option buttons to prevent translation
            if (element.classList.contains('language-option')) {
                return;
            }
            const key = element.getAttribute('data-lang') || element.getAttribute('data-i18n');
            const text = this.t(key);
            // 处理换行符，将 \n 转换为 <br>
            if (text.includes('\n')) {
                element.innerHTML = text.replace(/\n/g, '<br>');
            } else {
                element.textContent = text;
            }
        });

        // Update aria-label attributes
        document.querySelectorAll('[data-lang-aria]').forEach(element => {
            const key = element.getAttribute('data-lang-aria');
            element.setAttribute('aria-label', this.t(key));
        });

        // Update preview prompt if it's showing default text
        const previewContainer = document.getElementById('previewContainer');
        if (previewContainer && previewContainer.querySelector('p')) {
            const promptElement = previewContainer.querySelector('p[data-lang="preview.prompt"]');
            if (promptElement) {
                promptElement.textContent = this.t('preview.prompt');
            }
        }

        // Update custom palette title if it exists
        if (typeof updatePaletteTitle === 'function') {
            updatePaletteTitle();
        }
    }

    loadSavedLanguage() {
        const saved = localStorage.getItem('wplace-language');
        if (saved && this.translations[saved]) {
            this.currentLang = saved;
            const languageSelector = document.getElementById('languageSelector');
            if (languageSelector) {
                languageSelector.value = saved;
            }
            // 如果有保存的语言且翻译数据已存在，立即更新DOM
            if (document.readyState !== 'loading') {
                this.updateDOM();
            }
        }
    }

    saveLanguage() {
        localStorage.setItem('wplace-language', this.currentLang);
    }
}

// Initialize i18n
const i18n = new I18n();

// Mobile menu functionality
const initializeMobileMenu = () => {
    const menuIcon = document.getElementById('menuIcon');
    const languageIcon = document.getElementById('languageIcon');
    const mobileMenu = document.getElementById('mobileMenu');
    const languageMenu = document.getElementById('languageMenu');
    const closeMenu = document.getElementById('closeMenu');
    const closeLanguageMenu = document.getElementById('closeLanguageMenu');
    const languageOptions = document.querySelectorAll('.language-option');

    // Menu toggle
    menuIcon?.addEventListener('click', () => {
        mobileMenu.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    });

    closeMenu?.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        document.body.style.overflow = '';
    });

    // Language menu toggle
    languageIcon?.addEventListener('click', () => {
        languageMenu.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    });

    closeLanguageMenu?.addEventListener('click', () => {
        languageMenu.classList.add('hidden');
        document.body.style.overflow = '';
    });

    // Close menus when clicking outside
    mobileMenu?.addEventListener('click', (e) => {
        if (e.target === mobileMenu) {
            mobileMenu.classList.add('hidden');
            document.body.style.overflow = '';
        }
    });

    languageMenu?.addEventListener('click', (e) => {
        if (e.target === languageMenu) {
            languageMenu.classList.add('hidden');
            document.body.style.overflow = '';
        }
    });

    // Language selection
    languageOptions.forEach(option => {
        option.addEventListener('click', async () => {
            const lang = option.getAttribute('data-lang');
            if (i18n) {
                await i18n.loadLanguage(lang);
            }
            languageMenu.classList.add('hidden');
            document.body.style.overflow = '';
        });
    });
};

// Initialize immediately when script loads (since using defer)
async function initializeI18n() {
    try {
        // Load initial language with fallback support
        const savedLang = localStorage.getItem('wplace-language') || 'en';
        await i18n.loadLanguage(savedLang);
        console.log(`🌐 多语言系统初始化完成，当前语言: ${i18n.currentLang}`);
    } catch (error) {
        console.warn('多语言初始化失败，使用默认设置:', error);
        // 确保至少有英文备用翻译
        if (FALLBACK_TRANSLATIONS['en']) {
            i18n.translations['en'] = FALLBACK_TRANSLATIONS['en'];
            i18n.currentLang = 'en';
            i18n.updateDOM();
        }
    }
    
    // Initialize mobile menu
    initializeMobileMenu();
    
    // Language selector event
    const languageSelector = document.getElementById('languageSelector');
    if (languageSelector) {
        // 设置当前选中的语言
        languageSelector.value = i18n.currentLang;
        
        languageSelector.addEventListener('change', async (e) => {
            await i18n.loadLanguage(e.target.value);
        });
    }
}

// Export for global access
window.i18n = i18n;
window.initializeI18n = initializeI18n;
window.initializeMobileMenu = initializeMobileMenu;

// Auto-init when DOM is ready
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeI18n);
} else {
    // DOM already loaded
    initializeI18n();
}