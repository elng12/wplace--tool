        ['ko', 'es', 'fr', 'de', 'pt', 'tr', 'gn', 'mi'].forEach(lang => {
            this.translations[lang] = { ...this.translations.en };
        });
    }
    
    // 异步加载翻译文件
    // 异步加载翻译文件
    async loadTranslations(lang) {
        // 如果是file协议，直接返回内嵌翻译
        if (this.isFileProtocol) {
            if (this.translations[lang]) {
                console.log(`✅ 使用内嵌翻译: ${lang} (共 ${Object.keys(this.translations[lang]).length} 条)`);
                return this.translations[lang];
            } else {
                console.log(`⚠️ ${lang} 翻译不可用，使用英文回退`);
                return this.translations.en || {};
            }
        }
        
        if (this.translations[lang]) {
            return this.translations[lang];
        }

        try {
            console.log(`💾 尝试加载翻译文件: ${lang}.json`);
            const response = await fetch(`lang/${lang}.json`);
            if (!response.ok) {
                throw new Error(`HTTP ${response.status}: Failed to load ${lang}.json`);
            }
            const translations = await response.json();
            this.translations[lang] = translations;
            console.log(`✅ 翻译文件已加载: ${lang}.json (共 ${Object.keys(translations).length} 条)`);
            return translations;
        } catch (error) {
            console.error(`❌ 无法加载翻译文件 ${lang}.json:`, error);
            
            // 如果是非英语语言，使用基本的英文翻译作为回退
            if (lang !== 'en') {
                const fallbackTranslations = this.getFallbackTranslations();
                this.translations[lang] = fallbackTranslations;
                console.warn(`⚠️ 使用基本英文翻译作为 ${lang} 的回退`);
                return fallbackTranslations;
            }
            
            return {};
        }
    }
    
    // 获取基本的英文翻译作为回退
    getFallbackTranslations() {
        return {
            "brand.name": "Wplace Paint Tool",
            "nav.home": "Home",
            "nav.converter": "Converter", 
            "nav.blog": "Blog",
            "nav.about": "About",
            "nav.privacy": "Privacy",
            "nav.terms": "Terms",
            "hero.title": "Wplace Paint Tool: The Ultimate Pixel Toolkit",
            "hero.description": "Transform any image into stunning pixel art with our advanced converter",
            "upload.main": "Click to upload or drag image here",
            "upload.sub": "Supports PNG, JPG formats (max 4MB)",
            "upload.batch": "Supports multiple file batch processing",
            "pixel.size": "Pixel Size",
            "pixel.desc": "Auto-converts as you adjust the slider",
            "advanced.title": "Advanced Settings",
            "btn.download": "Download",
            "btn.process": "Process",
            "btn.reset": "Reset",
            "loading": "Processing...",
            "palette.title": "Wplace 64-Color Palette"
        };
    }

    // 获取翻译
    t(key, fallback = null) {
        const translation = this.translations[this.currentLang]?.[key] || 
                          this.translations.en?.[key] || 
                          fallback || 
                          key;
        return translation;
    }
    
    // 切换语言（异步）
    async setLanguage(lang) {
        if (this.supportedLangs.includes(lang)) {
            console.log(`🔄 切换语言到: ${lang}`);
            
            // 加载翻译文件
            await this.loadTranslations(lang);
            
            this.currentLang = lang;
            localStorage.setItem('preferredLanguage', lang);
            this.updatePage();
            return true;
        }
        return false;
    }
    
    // 更新页面翻译
    updatePage() {
        const elements = document.querySelectorAll('[data-lang]');
        let translatedCount = 0;
        
        elements.forEach(el => {
            const key = el.getAttribute('data-lang');
            const translation = this.t(key);
            
            if (translation !== key) {
                if (el.innerHTML.includes('<br>') || translation.includes('\n')) {
                    el.innerHTML = translation.replace(/\n/g, '<br>');
                } else {
                    el.textContent = translation;
                }
                translatedCount++;
            }
        });
        
        // 更新语言选择器
        const selector = document.getElementById('languageSelector');
        if (selector && selector.value !== this.currentLang) {
            selector.value = this.currentLang;
        }
        
        // 更新文档语言属性
        document.documentElement.lang = this.currentLang;
        
        console.log(`✅ 翻译完成: ${translatedCount}/${elements.length} 个元素`);
    }
    
    // 初始化（异步）
    async init() {
        console.log('🌍 翻译系统初始化 - Wplace Paint Tool');
        console.log('🌍 当前语言:', this.currentLang);
        console.log('🌍 支持语言:', this.supportedLangs);
        console.log('🌍 运行环境:', this.isFileProtocol ? 'file协议 (本地文件)' : 'HTTP服务器');
        
        try {
            // 预加载当前语言和英语翻译
            if (this.isFileProtocol) {
                console.log('✅ 内嵌翻译已准备就绪');
            } else {
                console.log('💾 开始加载翻译文件...');
                this.loadingPromise = Promise.all([
                    this.loadTranslations('en'), // 始终加载英语作为回退
                    this.currentLang !== 'en' ? this.loadTranslations(this.currentLang) : Promise.resolve()
                ]);
                
                await this.loadingPromise;
            }
            
            // 绑定语言选择器
            const selector = document.getElementById('languageSelector');
            if (selector) {
                selector.value = this.currentLang;
                selector.addEventListener('change', async (e) => {
                    console.log(`🔄 用户选择语言: ${e.target.value}`);
                    await this.setLanguage(e.target.value);
                });
                console.log('✅ 语言选择器已绑定');
            } else {
                console.warn('⚠️ 找不到语言选择器 #languageSelector');
            }
            
            // 绑定移动菜单
            const mobileMenuButton = document.getElementById('mobileMenuButton');
            const mobileMenu = document.getElementById('mobileMenu');
            if (mobileMenuButton && mobileMenu) {
                mobileMenuButton.addEventListener('click', () => {
                    mobileMenu.classList.toggle('hidden');
                });
            }
            
            // 初始翻译
            this.updatePage();
            
            console.log('✅ 翻译系统初始化完成');
            
        } catch (error) {
            console.error('❌ 翻译系统初始化失败:', error);
            // 即使初始化失败，也尝试更新页面
            this.updatePage();
        }
    }
}

// 创建全局实例
let i18n = null;

// 初始化函数（异步）
async function initI18n() {
    if (!i18n) {
        i18n = new I18nSystem();
    }
    await i18n.init();
    
    // 导出全局函数
    window.t = i18n.t.bind(i18n);
    window.i18n = i18n;
}

// 自动初始化
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initI18n);
} else {
    initI18n();
}

// 导出
if (typeof module !== 'undefined' && module.exports) {
    module.exports = { I18nSystem, initI18n };
}