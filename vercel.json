{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "."
      }
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.wplacetool.app" }],
      "destination": "https://wplacetool.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "wplace-tool-eosin.vercel.app" }],
      "destination": "https://wplacetool.app/:path*",
      "permanent": true
    },
    {
      "source": "/:locale(zh|tr|ko|ja|es|fr|de|pt|mi|gn)",
      "destination": "/:locale/",
      "permanent": true
    }
  ]
}
